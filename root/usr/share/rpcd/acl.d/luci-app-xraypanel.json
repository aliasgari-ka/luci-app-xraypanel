{
	"luci-app-xraypanel": {
		"description": "Grant access to the Xray panel",
		"read": {
			"cgi-io": [ "exec" ],
			"file": {
				"/usr/share/xraypanel/status.sh": [ "exec" ],
				"/sbin/logread -l 400 -e xray": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec" ],
				"iwinfo": [ "assoclist", "info" ],
				"luci-rpc": [ "getWirelessDevices", "getNetworkDevices", "getBoardJSON", "getHostHints" ],
				"network.interface": [ "dump" ],
				"network": [ "get_proto_handlers" ]
			},
			"uci": [ "xraypanel", "wireless", "network", "firewall", "dhcp" ]
		},
		"write": {
			"cgi-io": [ "exec" ],
			"file": {
				"/usr/share/xraypanel/ctl.sh restart": [ "exec" ],
				"/usr/share/xraypanel/ctl.sh geo": [ "exec" ],
				"/usr/share/xraypanel/ctl.sh test": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec" ]
			},
			"uci": [ "xraypanel", "wireless", "network", "firewall", "dhcp" ]
		}
	}
}
